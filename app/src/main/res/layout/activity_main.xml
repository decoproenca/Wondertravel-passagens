<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF6B00"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:text="WonderTravel Passagens"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuração da busca"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Origem"
                android:textColor="#555555"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/originMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:paddingHorizontal="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Destino (código do aeroporto)"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/destination"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="Ex.: BPS"
                android:inputType="textCapCharacters"
                android:maxLength="3"
                android:paddingHorizontal="14dp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Datas de ida"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/outboundDates"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="dd/mm/aaaa, dd/mm/aaaa"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Datas de volta"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/returnDates"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="dd/mm/aaaa, dd/mm/aaaa"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Use dd/mm/aaaa e separe várias datas com vírgulas."
                android:textColor="#777777"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adultos"
                        android:textColor="#555555"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/adults"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="5dp"
                        android:background="#FFFFFF"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:textColor="#222222" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crianças (2–11 anos)"
                        android:textColor="#555555"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/children"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="5dp"
                        android:background="#FFFFFF"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:textColor="#222222" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Alertar abaixo de (milhas por viajante)"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/targetMiles"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="Ex.: 31000"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Intervalo entre verificações (minutos)"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/intervalMinutes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="Mínimo: 15"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="#222222" />

            <Button
                android:id="@+id/saveConfig"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#FF6B00"
                android:text="Salvar configuração"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/testSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#E2E2E2"
                android:text="Verificar agora"
                android:textAllCaps="false"
                android:textColor="#222222" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startMonitor"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2E7D32"
                    android:text="Ativar monitor"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/stopMonitor"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D8D8D8"
                    android:text="Parar"
                    android:textAllCaps="false"
                    android:textColor="#333333" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:text="Configure sua busca."
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <WebView
        android:id="@+id/webView"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>
